ục, trang bị. Đứng đúng vị trí theo số thứ tự, thực hiện đúng chức trách nhiệm vụ.\",w:[\"Phục tùng mệnh lệnh; giữ im lặng; đứng đúng vị trí; không tự ý rời hàng.\",\"Thực hiện đúng các động tác đội ngũ; giữ khoảng cách đúng quy định; không nói chuyện riêng.\",\"Kiểm tra trang phục trước khi xếp hàng; đứng theo thứ tự chiều cao; chấp hành mệnh lệnh.\"]},\n{id:66,q:\"Theo quy định về Điều lệnh đội ngũ CAND hiện hành, động tác chào thực hiện như thế nào?\",a:\"Cánh tay trên nâng lên ngang với thân người, tạo với thân người một góc 80°.\",w:[\"Cánh tay trên nâng lên tạo với thân người một góc 90°.\",\"Cánh tay trên nâng lên tạo với thân người một góc 45°.\",\"Cánh tay trên nâng lên tạo với thân người một góc 60°.\"]},\n{id:67,q:\"Đồng chí cho biết giãn cách giữa hai cán bộ, chiến sĩ đứng cạnh nhau trên 1 hàng ngang là bao nhiêu?\",a:\"70 cen-ti-mét.\",w:[\"80 cen-ti-mét.\",\"60 cen-ti-mét.\",\"50 cen-ti-mét.\"]},\n{id:68,q:\"Đồng chí cho biết cự ly giữa hai cán bộ, chiến sĩ đứng liền trước sau nhau là bao nhiêu?\",a:\"100 cen-ti-mét.\",w:[\"80 cen-ti-mét.\",\"90 cen-ti-mét.\",\"120 cen-ti-mét.\"]},\n{id:69,q:\"Đồng chí cho biết độ dài bước tiến, bước lùi là bao nhiêu?\",a:\"75 cen-ti-mét.\",w:[\"70 cen-ti-mét.\",\"80 cen-ti-mét.\",\"85 cen-ti-mét.\"]},\n{id:70,q:\"Đồng chí cho biết độ dài bước đi đều, đi nghiêm là bao nhiêu?\",a:\"75 cen-ti-mét.\",w:[\"70 cen-ti-mét.\",\"80 cen-ti-mét.\",\"85 cen-ti-mét.\"]},\n{id:71,q:\"Đồng chí cho biết độ dài bước chạy là bao nhiêu?\",a:\"85 cen-ti-mét.\",w:[\"75 cen-ti-mét.\",\"80 cen-ti-mét.\",\"90 cen-ti-mét.\"]},\n{id:72,q:\"Điều lệnh đội ngũ CAND quy định độ dài bước qua phải, qua trái là bao nhiêu?\",a:\"35 cen-ti-mét.\",w:[\"30 cen-ti-mét.\",\"40 cen-ti-mét.\",\"25 cen-ti-mét.\"]},\n{id:73,q:\"Đồng chí cho biết tốc độ đi đều, đi nghiêm là bao nhiêu?\",a:\"106 bước/1 phút.\",w:[\"100 bước/1 phút.\",\"110 bước/1 phút.\",\"120 bước/1 phút.\"]},\n{id:74,q:\"Đồng chí cho biết tốc độ chạy là bao nhiêu?\",a:\"170 bước/phút.\",w:[\"160 bước/phút.\",\"180 bước/phút.\",\"150 bước/phút.\"]},\n{id:75,q:\"Vị trí đôn đốc và truyền đạt mệnh lệnh đối với đội hình tiểu đội hàng ngang cách đội hình đơn vị mấy bước?\",a:\"Từ 3 đến 5 bước.\",w:[\"Từ 2 đến 3 bước.\",\"Từ 5 đến 8 bước.\",\"Từ 4 đến 6 bước.\"]},\n{id:76,q:\"Đồng chí cho biết khi chỉnh hàng dọc đội hình tiểu đội, người chỉ huy đứng ở vị trí nào?\",a:\"Phía chính giữa đội hình, cách đội hình từ 2 đến 3 bước.\",w:[\"Phía bên phải đội hình, cách đội hình từ 3 đến 5 bước.\",\"Phía trước đội hình, cách đội hình 5 bước.\",\"Phía bên trái đội hình, cách đội hình từ 2 đến 3 bước.\"]},\n{id:77,q:\"CBCS khi di chuyển trên 5 bước thì phải thực hiện động tác di chuyển nào?\",a:\"Đi đều hoặc chạy đều.\",w:[\"Đi nghiêm.\",\"Chạy nhanh.\",\"Đi thường.\"]},\n{id:78,q:\"Vị trí đôn đốc và truyền đạt mệnh lệnh đối với đội hình trung đội hàng ngang cách đội hình đơn vị mấy bước?\",a:\"Từ 5 đến 8 bước.\",w:[\"Từ 3 đến 5 bước.\",\"Từ 8 đến 10 bước.\",\"Từ 4 đến 6 bước.\"]},\n{id:79,q:\"Đối với CBCS vi phạm điều lệnh bị xử lý bằng hình thức Không xét tặng danh hiệu thi đua năm đến xếp loại Không hoàn thành nhiệm vụ năm thì Thủ trưởng đơn vị, lãnh đạo, chỉ huy phụ trách trực tiếp bị xử lý bằng hình thức gì?\",a:\"Hạ một bậc danh hiệu thi đua năm.\",w:[\"Phê bình.\",\"Cảnh cáo.\",\"Hạ hai bậc danh hiệu thi đua năm.\"]},\n{id:80,q:\"Nguyên tắc xử lý vi phạm điều lệnh CAND nào sau đây là đúng?\",a:\"Mỗi hành vi vi phạm chỉ xử lý một lần. Trong cùng một vụ việc có nhiều cán bộ chiến sĩ vi phạm thì mỗi cán bộ, chiến sĩ đều bị xử lý về hành vi vi phạm của mình.\",w:[\"Mỗi hành vi vi phạm có thể bị xử lý nhiều lần nếu tái phạm trong cùng năm.\",\"Trong cùng một vụ việc, chỉ xử lý người chịu trách nhiệm chính.\",\"Mỗi hành vi vi phạm chỉ xử lý một lần, nếu nhiều người vi phạm thì xử lý người có cấp bậc cao nhất.\"]},\n{id:81,q:\"Quy định về xử lý trách nhiệm liên đới nào sau đây là đúng?\",a:\"Đơn vị vi phạm bị xử lý bằng hình thức hạ một bậc danh hiệu thi đua năm, thủ trưởng đơn vị bị xử lý bằng hình thức phê bình.\",w:[\"Đơn vị vi phạm bị phê bình, thủ trưởng đơn vị bị hạ một bậc danh hiệu thi đua năm.\",\"Đơn vị và thủ trưởng đơn vị cùng bị hạ một bậc danh hiệu thi đua năm.\",\"Đơn vị bị cảnh cáo, thủ trưởng đơn vị bị khiển trách.\"]},\n{id:82,q:\"Cán bộ, chiến sĩ vi phạm điều lệnh CAND bị xử lý bằng hình thức hạ hai bậc danh hiệu thi đua năm đến hạ hai bậc xếp loại cán bộ trong năm thì xử lý trách nhiệm liên đới của lãnh đạo, chỉ huy trực tiếp quản lý cán bộ tại thời điểm vi phạm nào sau đây là đúng quy định?\",a:\"Lãnh đạo, chỉ huy trực tiếp quản lý cán bộ tại thời điểm cán bộ, chiến sĩ vi phạm bị xử lý bằng hình thức hạ một bậc danh hiệu thi đua năm.\",w:[\"Lãnh đạo, chỉ huy trực tiếp bị xử lý bằng hình thức phê bình.\",\"Lãnh đạo, chỉ huy trực tiếp bị xử lý bằng hình thức hạ hai bậc danh hiệu thi đua năm.\",\"Lãnh đạo, chỉ huy trực tiếp bị xử lý bằng hình thức cảnh cáo.\"]},\n{id:83,q:\"Trường hợp nào sau đây cán bộ, chiến sĩ vi phạm điều lệnh bị xử lý kỷ luật mà thủ trưởng đơn vị, lãnh đạo, chỉ huy phụ trách trực tiếp cán bộ, chiến sĩ không bị xử lý trách nhiệm liên đới?\",a:\"Cán bộ, chiến sĩ vi phạm điều lệnh mà trước đó thủ trưởng đơn vị, lãnh đạo, chỉ huy phụ trách trực tiếp đã nhắc nhở, chấn chỉnh bằng văn bản. Cán bộ, chiến sĩ vi phạm điều lệnh mà trước đó thủ trưởng đơn vị, lãnh đạo, chỉ huy phụ trách trực tiếp đã nhắc nhở, chấn chỉnh trong cuộc họp, giao ban của đơn vị (nội dung chấn chỉnh, nhắc nhở được ghi trong biên bản họp, giao ban của đơn vị).\",w:[\"Cán bộ, chiến sĩ vi phạm ngoài giờ làm việc và không liên quan đến nhiệm vụ được giao.\",\"Cán bộ, chiến sĩ vi phạm lần đầu và mức vi phạm nhẹ.\",\"Cán bộ, chiến sĩ vi phạm khi đang biệt phái tại đơn vị khác.\"]},\n{id:84,q:\"Cán bộ, chiến sĩ không tham gia chào cờ Tổ quốc theo quy định bị áp dụng hình thức xử lý nào là đúng quy định?\",a:\"Hạ một bậc danh hiệu thi đua năm.\",w:[\"Phê bình.\",\"Cảnh cáo.\",\"Khiển trách.\"]},\n{id:85,q:\"Cán bộ, chiến sĩ tham gia tập huấn điều lệnh, quân sự, võ thuật CAND trong năm mà kết quả không đạt yêu cầu bị xử lý như thế nào là đúng quy định?\",a:\"Hạ một bậc danh hiệu thi đua năm.\",w:[\"Phê bình.\",\"Không xét tặng danh hiệu thi đua năm.\",\"Hạ hai bậc danh hiệu thi đua năm.\"]},\n{id:86,q:\"Cán bộ, chiến sĩ vi phạm: Làm việc không có chương trình, kế hoạch; không xây dựng chương trình, kế hoạch công tác tuần bị áp dụng hình thức xử lý nào là đúng quy định?\",a:\"Hạ một bậc xếp loại cán bộ trong năm.\",w:[\"Hạ một bậc danh hiệu thi đua năm.\",\"Phê bình.\",\"Cảnh cáo.\"]},\n{id:87,q:\"Cán bộ, chiến sĩ vi phạm quy định nào sau đây, bị áp dụng hình thức xử lý hạ hai bậc xếp loại cán bộ trong năm?\",a:\"Gây mất đoàn kết nội bộ, ảnh hưởng đến việc thực hiện nhiệm vụ chính trị và uy tín của lực lượng Công an nhân dân. Bao che, không xử lý vi phạm điều lệnh hoặc áp dụng các hình thức xử lý vi phạm không đúng quy định, kéo dài thời hạn hoặc trì hoãn việc xử lý vi phạm điều lệnh.\",w:[\"Không chấp hành mệnh lệnh cấp trên và vắng mặt không lý do.\",\"Vi phạm quy định về trang phục và tư thế, lễ tiết, tác phong nhiều lần.\",\"Không hoàn thành nhiệm vụ được giao và gây thiệt hại cho đơn vị.\"]},\n{id:88,q:\"Cán bộ, chiến sĩ vi phạm các quy định về trật tự an toàn giao thông bị xử lý như thế nào theo quy định hiện hành?\",a:\"Hạ hai bậc danh hiệu thi đua năm.\",w:[\"Hạ một bậc danh hiệu thi đua năm.\",\"Cảnh cáo.\",\"Khiển trách.\"]},\n{id:89,q:\"Cán bộ, chiến sĩ giao phương tiện, thiết bị kỹ thuật nghiệp vụ phục vụ công tác cho người không có đủ thẩm quyền và điều kiện sử dụng bị xử lý như thế nào theo quy định hiện hành?\",a:\"Khiển trách.\",w:[\"Cảnh cáo.\",\"Hạ một bậc danh hiệu thi đua năm.\",\"Hạ hai bậc danh hiệu thi đua năm.\"]},\n{id:90,q:\"Cán bộ, chiến sĩ có 02 năm liên tiếp không hoàn thành cùng một nội dung thực hành điều lệnh, quân sự, võ thuật thì bị xử lý như thế nào theo quy định hiện hành?\",a:\"Xem xét hạ một bậc danh hiệu thi đua vào năm thứ 2 không đạt yêu cầu.\",w:[\"Khiển trách.\",\"Hạ hai bậc danh hiệu thi đua năm.\",\"Cảnh cáo.\"]},\n{id:91,q:\"Cán bộ, chiến sĩ đi học tập trung, vừa làm vừa học tại các trường trong CAND, không tham gia tập huấn tại đơn vị mà không có xác nhận kết quả tập huấn điều lệnh, quân sự, võ thuật trong năm gửi về đơn vị cử đi học thì bị xử lý như thế nào theo quy định hiện hành?\",a:\"Bỏ tập huấn không có lý do, xử lý kỷ luật khiển trách.\",w:[\"Hạ một bậc danh hiệu thi đua năm.\",\"Phê bình và yêu cầu tập huấn bổ sung.\",\"Cảnh cáo.\"]},\n{id:92,q:\"Trong ngày làm việc, giờ trực, giờ nghỉ trưa của ngày làm việc, ngày trực lãnh đạo, chỉ huy Công an từ cấp đội, cấp xã, cấp đại đội trực thuộc trở lên mà trong máu hoặc hơi thở có nồng độ cồn thì xử lý bằng hình thức nào theo quy định hiện hành?\",a:\"Cảnh cáo.\",w:[\"Khiển trách.\",\"Hạ bậc lương.\",\"Hạ cấp bậc hàm.\"]},\n{id:93,q:\"Đơn vị có tổng số lượt cán bộ, chiến sĩ vi phạm điều lệnh trong năm có từ 5% đến dưới 10% thì bị xử lý bằng hình thức nào theo quy định hiện hành?\",a:\"Hạ một bậc danh hiệu thi đua năm.\",w:[\"Phê bình.\",\"Hạ hai bậc danh hiệu thi đua năm.\",\"Hạ một bậc xếp loại đơn vị trong năm.\"]},\n{id:94,q:\"Đơn vị vi phạm việc thực hiện không đúng quy định của Bộ trưởng Bộ Công an về nội vụ, vệ sinh trụ sở cơ quan, doanh trại; nơi ăn, ngủ, nghỉ của cán bộ, chiến sĩ; nơi sinh hoạt văn hoá, các trung tâm, cơ sở tập luyện, thi đấu điều lệnh, quân sự, võ thuật, thể dục, thể thao; nơi tiếp khách; nơi tiếp nhận, giải quyết thủ tục hành chính; công tác phòng, chống cháy nổ, thiên tai, dịch bệnh và bảo vệ môi trường bị áp dụng hình thức xử lý nào là đúng quy định?\",a:\"Phê bình.\",w:[\"Hạ một bậc danh hiệu thi đua năm.\",\"Cảnh cáo.\",\"Hạ một bậc xếp loại đơn vị trong năm.\"]},\n{id:95,q:\"Đơn vị vi phạm trong giờ làm việc, giờ trực, ngày trực tại đơn vị có từ 5% cán bộ, chiến sĩ trở lên không mặc trang phục CAND hoặc mặc trang phục không đúng quy định của Bộ trưởng Bộ Công an trừ trường hợp Bộ có quy định khác; lập bàn thờ, để bát hương, thắp hương không đúng quy định trong phạm vi trụ sở đơn vị, trừ khi tổ chức lễ tang, lập bàn thờ Chủ tịch Hồ Chí Minh, thắp hương trong các ngày nghỉ Tết Nguyên đán theo quy định của Nhà nước, bị áp dụng hình thức xử lý nào là đúng quy định?\",a:\"Hạ một bậc danh hiệu thi đua năm.\",w:[\"Phê bình.\",\"Hạ hai bậc danh hiệu thi đua năm.\",\"Cảnh cáo.\"]},\n{id:96,q:\"Đơn vị quán triệt không đầy đủ, kịp thời các văn bản chỉ đạo của cấp trên về công tác điều lệnh, quân sự, võ thuật thì bị xử lý bằng hình thức nào theo quy định hiện hành?\",a:\"Hạ một bậc xếp loại đơn vị trong năm.\",w:[\"Phê bình.\",\"Hạ một bậc danh hiệu thi đua năm.\",\"Hạ hai bậc xếp loại đơn vị trong năm.\"]},\n{id:97,q:\"Đơn vị không phổ biến, không tổ chức thực hiện chỉ thị, mệnh lệnh, kế hoạch, quyết định, quy trình, quy chế, quy định của cấp trên; bao che, xử lý không đúng quy định hoặc không xử lý vi phạm điều lệnh thì bị xử lý bằng hình thức nào theo quy định hiện hành?\",a:\"Hạ hai bậc xếp loại đơn vị trong năm.\",w:[\"Hạ một bậc xếp loại đơn vị trong năm.\",\"Hạ một bậc danh hiệu thi đua năm.\",\"Không xét tặng danh hiệu thi đua năm.\"]},\n{id:98,q:\"Không tổ chức tập huấn điều lệnh, quân sự, võ thuật trong năm thì Đơn vị, cấp trưởng và cấp phó trực tiếp phụ trách công tác điều lệnh, quân sự, võ thuật bị xử lý như thế nào theo quy định hiện hành?\",a:\"Đơn vị bị xếp loại không hoàn thành nhiệm vụ, cấp trưởng và cấp phó trực tiếp phụ trách xem xét hạ hai bậc thi đua trong năm.\",w:[\"Đơn vị bị hạ hai bậc xếp loại, cấp trưởng bị khiển trách.\",\"Đơn vị bị hạ một bậc danh hiệu thi đua, cấp trưởng và cấp phó bị phê bình.\",\"Đơn vị bị cảnh cáo, cấp trưởng và cấp phó bị hạ một bậc danh hiệu thi đua.\"]},\n{id:99,q:\"Đơn vị có tổng số lượt cán bộ, chiến sĩ vi phạm điều lệnh trong năm có tỉ lệ từ 15% đến dưới 20% so với biên chế của đơn vị, bị xử lý hình thức nào theo quy định hiện hành?\",a:\"Hạ một bậc xếp loại đơn vị trong năm.\",w:[\"Hạ hai bậc danh hiệu thi đua năm.\",\"Hạ một bậc danh hiệu thi đua năm.\",\"Hạ hai bậc xếp loại đơn vị trong năm.\"]},\n{id:100,q:\"Thời gian xử lý vi phạm điều lệnh CAND (trường hợp thông thường) là bao nhiêu ngày (ngày làm việc), kể từ khi nhận được thông báo kết quả kiểm tra điều lệnh?\",a:\"20 ngày.\",w:[\"15 ngày.\",\"30 ngày.\",\"10 ngày.\"]}\n];\n\nlet state = loadState();\nlet currentQuiz = null;\nlet currentQIndex = 0;\nlet quizAnswered = false;\nlet examTimer = null;\nlet examTimeLeft = 0;\n\nfunction defaultState() {\n  return { results: {}, bookmarks: [], totalCorrect: 0, totalWrong: 0, bestStreak: 0, currentStreak: 0 };\n}\nfunction loadState() {\n  try { const s = localStorage.getItem('quiz_dieulenh_v2'); if (s) return JSON.parse(s); } catch(e) {}\n  return defaultState();\n}\nfunction saveState() { localStorage.setItem('quiz_dieulenh_v2', JSON.stringify(state)); }\nfunction resetProgress() { state = defaultState(); saveState(); updateHomeStats(); updateReviewList(); updateStatsTab(); alert('Đã đặt lại toàn bộ tiến độ!'); }\n\nfunction showTab(tab) {\n  ['home','quiz','review','stats'].forEach(t => document.getElementById('tab-'+t).classList.toggle('hidden', t !== tab));\n  document.querySelectorAll('.nav-tab').forEach((el, i) => { const tabs = ['home','quiz','review','stats']; el.classList.toggle('active', tabs[i] === tab); });\n  if (tab === 'home') updateHomeStats();\n  if (tab === 'review') updateReviewList();\n  if (tab === 'stats') updateStatsTab();\n}\n\nfunction updateHomeStats() {\n  const answered = Object.keys(state.results).length;\n  let correct = 0;\n  Object.values(state.results).forEach(r => { if (r.lastResult) correct++; });\n  const rate = answered > 0 ? Math.round((correct/answered)*100) : 0;\n  document.getElementById('home-progress').style.width = answered + '%';\n  document.getElementById('home-progress-text').textContent = answered + '/100 câu đã ôn';\n  document.getElementById('home-correct').textContent = state.totalCorrect;\n  document.getElementById('home-wrong').textContent = state.totalWrong;\n  document.getElementById('home-rate').textContent = rate + '%';\n  document.getElementById('home-streak').textContent = state.bestStreak;\n}\n\nfunction startQuiz(mode, from, to) {\n  let qs = [];\n  if (mode === 'learn') { qs = questions.filter(q => q.id >= from && q.id <= to); }\n  else if (mode === 'wrong') { qs = questions.filter(q => { const r = state.results[q.id]; return r && !r.lastResult; }); if (!qs.length) { alert('Chưa có câu trả lời sai nào!'); return; } }\n  else if (mode === 'bookmark') { qs = questions.filter(q => state.bookmarks.includes(q.id)); if (!qs.length) { alert('Chưa đánh dấu câu nào! Nhấn ☆ khi làm bài.'); return; } }\n  else if (mode === 'exam') { qs = [...questions]; shuffleArray(qs); }\n  else if (mode === 'random') { qs = [...questions]; shuffleArray(qs); qs = qs.slice(0, 20); }\n  currentQuiz = { mode, from, to, questions: qs, answers: [], correctCount: 0, wrongCount: 0, startTime: Date.now() };\n  currentQIndex = 0;\n  showTab('quiz');\n  document.getElementById('quiz-active').classList.remove('hidden');\n  document.getElementById('quiz-complete').classList.add('hidden');\n  document.getElementById('quiz-empty').classList.add('hidden');\n  if (mode === 'exam') { examTimeLeft = 90 * 60; document.getElementById('quiz-timer').classList.remove('hidden'); startExamTimer(); }\n  else { document.getElementById('quiz-timer').classList.add('hidden'); if (examTimer) clearInterval(examTimer); }\n  showQuestion();\n}\n\nfunction startExamTimer() {\n  if (examTimer) clearInterval(examTimer);\n  updateTimerDisplay();\n  examTimer = setInterval(() => { examTimeLeft--; updateTimerDisplay(); if (examTimeLeft <= 0) { clearInterval(examTimer); finishQuiz(); } }, 1000);\n}\nfunction updateTimerDisplay() {\n  const m = Math.floor(examTimeLeft / 60), s = examTimeLeft % 60;\n  const el = document.getElementById('quiz-timer');\n  el.textContent = `⏱️ ${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;\n  el.style.color = examTimeLeft < 300 ? 'var(--danger)' : 'var(--accent)';\n}\n\nfunction showQuestion() {\n  if (!currentQuiz || currentQIndex >= currentQuiz.questions.length) { finishQuiz(); return; }\n  quizAnswered = false;\n  const q = currentQuiz.questions[currentQIndex], total = currentQuiz.questions.length;\n  document.getElementById('quiz-counter').textContent = `Câu ${currentQIndex+1}/${total}`;\n  document.getElementById('quiz-score').textContent = `✅ ${currentQuiz.correctCount} | ❌ ${currentQuiz.wrongCount}`;\n  document.getElementById('quiz-progress').style.width = ((currentQIndex/total)*100) + '%';\n  document.getElementById('q-badge').textContent = `Câu ${q.id}`;\n  document.getElementById('q-text').textContent = q.q;\n  document.getElementById('bookmark-btn').textContent = state.bookmarks.includes(q.id) ? '★' : '☆';\n  const options = [{ text: q.a, correct: true }, ...q.w.map(w => ({ text: w, correct: false }))];\n  shuffleArray(options);\n  document.getElementById('q-options').innerHTML = options.map((opt, i) => {\n    const letter = String.fromCharCode(65 + i);\n    return `<div class=\"option-btn\" onclick=\"selectAnswer(this, ${opt.correct}, ${q.id})\" data-correct=\"${opt.correct}\"><span class=\"option-letter\">${letter}</span><span>${opt.text}</span></div>`;\n  }).join('');\n  document.getElementById('q-explanation').classList.add('hidden');\n  document.getElementById('q-buttons').innerHTML = `<button class=\"btn btn-outline\" onclick=\"skipQuestion()\">Bỏ qua →</button>`;\n  document.getElementById('question-card').classList.remove('fade-in');\n  setTimeout(() => document.getElementById('question-card').classList.add('fade-in'), 10);\n}\n\nfunction selectAnswer(el, isCorrect, qId) {\n  if (quizAnswered) return;\n  quizAnswered = true;\n  const q = questions.find(x => x.id === qId);\n  document.querySelectorAll('.option-btn').forEach(btn => { btn.classList.add('disabled'); if (btn.dataset.correct === 'true') btn.classList.add('correct'); });\n  if (!isCorrect) el.classList.add('wrong');\n  if (!state.results[qId]) state.results[qId] = { correct: 0, wrong: 0, lastResult: false, lastDate: '' };\n  if (isCorrect) { state.results[qId].correct++; state.results[qId].lastResult = true; state.totalCorrect++; currentQuiz.correctCount++; state.currentStreak++; if (state.currentStreak > state.bestStreak) state.bestStreak = state.currentStreak; }\n  else { state.results[qId].wrong++; state.results[qId].lastResult = false; state.totalWrong++; currentQuiz.wrongCount++; state.currentStreak = 0; }\n  state.results[qId].lastDate = new Date().toISOString();\n  currentQuiz.answers.push({ qId, isCorrect });\n  saveState();\n  const expEl = document.getElementById('q-explanation');\n  expEl.classList.remove('hidden', 'correct-exp', 'wrong-exp');\n  expEl.classList.add(isCorrect ? 'correct-exp' : 'wrong-exp');\n  expEl.innerHTML = isCorrect ? `<strong>✅ Chính xác!</strong>` : `<strong>❌ Sai rồi!</strong><br><br><strong>Đáp án đúng:</strong><br>${q.a}`;\n  document.getElementById('quiz-score').textContent = `✅ ${currentQuiz.correctCount} | ❌ ${currentQuiz.wrongCount}`;\n  const isLast = currentQIndex >= currentQuiz.questions.length - 1;\n  document.getElementById('q-buttons').innerHTML = `<button class=\"btn btn-primary\" onclick=\"${isLast ? 'finishQuiz()' : 'nextQuestion()'}\">${isLast ? '🏁 Kết thúc' : 'Câu tiếp theo →'}</button>`;\n}\n\nfunction skipQuestion() { currentQIndex++; showQuestion(); }\nfunction nextQuestion() { currentQIndex++; showQuestion(); }\n\nfunction finishQuiz() {\n  if (examTimer) clearInterval(examTimer);\n  const total = currentQuiz.answers.length, correct = currentQuiz.correctCount;\n  const rate = total > 0 ? Math.round((correct/total)*100) : 0;\n  const elapsed = Math.round((Date.now() - currentQuiz.startTime) / 1000);\n  const mins = Math.floor(elapsed / 60), secs = elapsed % 60;\n  document.getElementById('quiz-active').classList.add('hidden');\n  document.getElementById('quiz-complete').classList.remove('hidden');\n  let icon = '🎉', title = 'Xuất sắc!', msg = '';\n  if (rate >= 90) { icon = '🏆'; title = 'Xuất sắc!'; msg = 'Bạn đã nắm vững kiến thức!'; }\n  else if (rate >= 70) { icon = '👏'; title = 'Tốt lắm!'; msg = 'Tiếp tục ôn thêm để hoàn thiện.'; }\n  else if (rate >= 50) { icon = '💪'; title = 'Cố gắng hơn!'; msg = 'Hãy ôn lại những câu sai nhé.'; }\n  else { icon = '📚'; title = 'Cần ôn thêm!'; msg = 'Đừng nản, hãy ôn lại từ đầu.'; }\n  document.getElementById('complete-icon').textContent = icon;\n  document.getElementById('complete-title').textContent = title;\n  document.getElementById('complete-score').textContent = `${correct}/${total}`;\n  document.getElementById('complete-msg').textContent = msg;\n  document.getElementById('complete-stats').innerHTML = `\n    <div class=\"stat-card\"><div class=\"stat-number\">${rate}%</div><div class=\"stat-label\">Tỉ lệ đúng</div></div>\n    <div class=\"stat-card\"><div class=\"stat-number\">${mins}:${String(secs).padStart(2,'0')}</div><div class=\"stat-label\">Thời gian</div></div>\n    <div class=\"stat-card\"><div class=\"stat-number\" style=\"color:var(--success)\">${correct}</div><div class=\"stat-label\">Đúng</div></div>\n    <div class=\"stat-card\"><div class=\"stat-number\" style=\"color:var(--danger)\">${total - correct}</div><div class=\"stat-label\">Sai</div></div>`;\n  const rb = document.getElementById('retry-btn');\n  if (currentQuiz.mode === 'learn') rb.onclick = () => startQuiz('learn', currentQuiz.from, currentQuiz.to);\n  else if (currentQuiz.mode === 'exam') rb.onclick = () => startQuiz('exam');\n  else if (currentQuiz.mode === 'random') rb.onclick = () => startQuiz('random');\n  else rb.onclick = () => startQuiz(currentQuiz.mode);\n}\n\nfunction toggleBookmark() {\n  if (!currentQuiz) return;\n  const q = currentQuiz.questions[currentQIndex];\n  const idx = state.bookmarks.indexOf(q.id);\n  if (idx >= 0) { state.bookmarks.splice(idx, 1); document.getElementById('bookmark-btn').textContent = '☆'; }\n  else { state.bookmarks.push(q.id); document.getElementById('bookmark-btn').textContent = '★'; }\n  saveState();\n}\n\nlet reviewFilter = 'all', reviewSearchText = '';\nfunction updateReviewList() {\n  const list = document.getElementById('review-list');\n  let filtered = questions;\n  if (reviewFilter === 'correct') filtered = filtered.filter(q => state.results[q.id] && state.results[q.id].lastResult);\n  else if (reviewFilter === 'wrong') filtered = filtered.filter(q => state.results[q.id] && !state.results[q.id].lastResult);\n  else if (reviewFilter === 'unseen') filtered = filtered.filter(q => !state.results[q.id]);\n  else if (reviewFilter === 'bookmarked') filtered = filtered.filter(q => state.bookmarks.includes(q.id));\n  if (reviewSearchText) { const s = reviewSearchText.toLowerCase(); filtered = filtered.filter(q => q.q.toLowerCase().includes(s) || q.a.toLowerCase().includes(s)); }\n  const correctCount = questions.filter(q => state.results[q.id] && state.results[q.id].lastResult).length;\n  const wrongCount = questions.filter(q => state.results[q.id] && !state.results[q.id].lastResult).length;\n  const unseenCount = questions.filter(q => !state.results[q.id]).length;\n  document.getElementById('filter-correct').textContent = `✅ Đúng (${correctCount})`;\n  document.getElementById('filter-wrong').textContent = `❌ Sai (${wrongCount})`;\n  document.getElementById('filter-unseen').textContent = `⬜ Chưa làm (${unseenCount})`;\n  document.getElementById('filter-bookmarked').textContent = `⭐ Đánh dấu (${state.bookmarks.length})`;\n  if (!filtered.length) { list.innerHTML = '<p style=\"text-align:center;color:var(--text-light);padding:20px\">Không có câu hỏi nào.</p>'; return; }\n  list.innerHTML = filtered.map(q => {\n    const r = state.results[q.id];\n    let statusHtml = '<span class=\"q-status\" style=\"color:var(--text-light)\">⬜ Chưa làm</span>';\n    if (r) statusHtml = r.lastResult ? '<span class=\"q-status pass\">✅ Đúng</span>' : '<span class=\"q-status fail\">❌ Sai</span>';\n    const bm = state.bookmarks.includes(q.id) ? '⭐ ' : '';\n    return `<div class=\"review-item\" onclick=\"showReviewDetail(${q.id})\"><span class=\"q-num\">${bm}Câu ${q.id}.</span> ${q.q.substring(0, 80)}...${statusHtml}</div>`;\n  }).join('');\n}\nfunction setReviewFilter(filter, btn) { reviewFilter = filter; document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active')); btn.classList.add('active'); updateReviewList(); }\nfunction filterReview(text) { reviewSearchText = text; updateReviewList(); }\nlet reviewDetailQId = null;\nfunction showReviewDetail(qId) {\n  reviewDetailQId = qId;\n  const q = questions.find(x => x.id === qId);\n  document.getElementById('rd-badge').textContent = `Câu ${q.id}`;\n  document.getElementById('rd-question').textContent = q.q;\n  document.getElementById('rd-answer').textContent = q.a;\n  document.getElementById('rd-bookmark').textContent = state.bookmarks.includes(q.id) ? '★' : '☆';\n  document.getElementById('review-detail').classList.remove('hidden');\n  document.getElementById('review-detail').scrollIntoView({ behavior: 'smooth' });\n}\nfunction closeReviewDetail() { document.getElementById('review-detail').classList.add('hidden'); }\nfunction toggleBookmarkReview() {\n  if (!reviewDetailQId) return;\n  const idx = state.bookmarks.indexOf(reviewDetailQId);\n  if (idx >= 0) { state.bookmarks.splice(idx, 1); document.getElementById('rd-bookmark').textContent = '☆'; }\n  else { state.bookmarks.push(reviewDetailQId); document.getElementById('rd-bookmark').textContent = '★'; }\n  saveState(); updateReviewList();\n}\n\nfunction updateStatsTab() {\n  const answered = Object.keys(state.results).length;\n  let mastered = 0;\n  Object.values(state.results).forEach(r => { if (r.correct >= 2 && r.lastResult) mastered++; });\n  document.getElementById('s-total').textContent = state.totalCorrect + state.totalWrong;\n  document.getElementById('s-correct').textContent = state.totalCorrect;\n  document.getElementById('s-wrong').textContent = state.totalWrong;\n  const total = state.totalCorrect + state.totalWrong;\n  document.getElementById('s-rate').textContent = total > 0 ? Math.round((state.totalCorrect/total)*100) + '%' : '0%';\n  document.getElementById('s-streak').textContent = state.bestStreak;\n  document.getElementById('s-mastered').textContent = mastered;\n  const groups = [{name:'Câu 1-25',from:1,to:25},{name:'Câu 26-50',from:26,to:50},{name:'Câu 51-75',from:51,to:75},{name:'Câu 76-100',from:76,to:100}];\n  let chartHtml = '';\n  groups.forEach(g => {\n    const qs = questions.filter(q => q.id >= g.from && q.id <= g.to);\n    let c = 0, w = 0, u = 0;\n    qs.forEach(q => { const r = state.results[q.id]; if (!r) u++; else if (r.lastResult) c++; else w++; });\n    const cp = Math.round((c/qs.length)*100), wp = Math.round((w/qs.length)*100);\n    chartHtml += `<div style=\"margin-bottom:12px\"><div style=\"display:flex;justify-content:space-between;margin-bottom:4px\"><span style=\"font-weight:600;font-size:0.85em\">${g.name}</span><span style=\"font-size:0.8em;color:var(--text-light)\">${c}✅ ${w}❌ ${u}⬜</span></div><div style=\"display:flex;height:20px;border-radius:10px;overflow:hidden;background:#e9ecef\"><div style=\"width:${cp}%;background:var(--success)\"></div><div style=\"width:${wp}%;background:var(--danger)\"></div></div></div>`;\n  });\n  document.getElementById('group-chart').innerHTML = chartHtml;\n  const hardest = questions.filter(q => state.results[q.id] && state.results[q.id].wrong > 0).sort((a, b) => (state.results[b.id]?.wrong || 0) - (state.results[a.id]?.wrong || 0)).slice(0, 5);\n  document.getElementById('hardest-questions').innerHTML = hardest.length ? hardest.map(q => { const r = state.results[q.id]; return `<div class=\"review-item\" onclick=\"showTab('review');showReviewDetail(${q.id})\"><span class=\"q-num\">Câu ${q.id}.</span> ${q.q.substring(0, 60)}...<span class=\"q-status fail\">${r.wrong} lần sai</span></div>`; }).join('') : '<p style=\"color:var(--text-light);text-align:center\">Chưa có dữ liệu</p>';\n}\n\nfunction shuffleArray(arr) { for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [arr[i], arr[j]] = [arr[j], arr[i]]; } }\n\nupdateHomeStats();\n</script>\n</body>\n</html>\n","Description":"Complete interactive quiz application with 100 questions on Vietnamese police regulations, featuring 6 study modes, progress tracking, and spaced repetition.","Overwrite":false,"TargetFile":"C:\\Users\\Acer\\.gemini\\antigravity\\brain\\04883a7b-f14e-427c-a92d-cdc41dece94d\\quiz_dieulenh.html","toolAction":"Creating quiz application","toolSummary":"Quiz HTML file"}}]}
