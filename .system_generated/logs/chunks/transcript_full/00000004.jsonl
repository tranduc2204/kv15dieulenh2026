em-sub\">\n          <strong style=\"color:var(--success)\">Đáp án đúng:</strong> ${correctText}\n        </div>\n      </div>\n    `;\n  }).join('');\n}\n\nfunction openSingleQuestion(id) {\n  const target = questions.find(q => q.id === id);\n  if (!target) return;\n  activeQuestions = [target];\n  currentQuizType = 'learn';\n  launchQuizSession(`Câu hỏi #${id}`);\n}\n\nfunction filterQuestions() { renderQuestionBank(); }\nfunction setFilter(f, btn) {\n  activeFilter = f;\n  document.querySelectorAll('.f-tab').forEach(b => b.classList.remove('active'));\n  btn.classList.add('active');\n  renderQuestionBank();\n}\n\n// OVERVIEW UI UPDATE\nfunction updateOverviewUI() {\n  const answeredCount = Object.keys(state.history).length;\n  const totalQ = questions.length;\n  const pct = Math.round((answeredCount / totalQ) * 100);\n\n  document.getElementById('bar-main').style.width = `${pct}%`;\n  document.getElementById('lbl-progress').textContent = `Đã ôn luyện: ${answeredCount}/${totalQ} câu (${pct}%)`;\n\n  const total = state.totalCorrect + state.totalWrong;\n  const acc = total > 0 ? Math.round((state.totalCorrect / total) * 100) : 0;\n  document.getElementById('lbl-accuracy').textContent = `Tỉ lệ đúng: ${acc}%`;\n\n  document.getElementById('st-total').textContent = state.totalAnswered;\n  document.getElementById('st-correct').textContent = state.totalCorrect;\n  document.getElementById('st-wrong').textContent = state.totalWrong;\n\n  // Mastered count (answered correctly at least twice with no recent wrong)\n  let mastered = 0;\n  Object.keys(state.history).forEach(id => {\n    const h = state.history[id];\n    if (h.correct >= 2 && !h.lastWrong) mastered++;\n  });\n  document.getElementById('st-mastered').textContent = mastered;\n\n  // Wrong & Star counts for quick mode buttons\n  const wrongCount = Object.values(state.history).filter(h => h.lastWrong).length;\n  document.getElementById('cnt-wrong').textContent = `${wrongCount} câu cần khắc phục`;\n  document.getElementById('cnt-star').textContent = `${state.stars.length} câu đã đánh dấu sao`;\n}\n\nfunction copyShareMessage() {\n  const text = `📋 BỘ 100 CÂU HỎI TRẮC NGHIỆM ĐIỀU LỆNH, QUÂN SỰ, VÕ THUẬT CAND 2026\\nĐã có ứng dụng tự ôn tập trên điện thoại và máy tính, gồm đầy đủ 100 câu hỏi chính thức (3 đáp án A, B, C chuẩn Bộ Công an).\\n👉 Đồng chí mở file đính kèm \"quiz_dieulenh.html\" bằng trình duyệt Chrome/Safari/Cốc Cốc là ôn được ngay!`;\n  navigator.clipboard.writeText(text).then(() => {\n    document.getElementById('copy-status').textContent = '✅ Đã sao chép nội dung lời nhắn!';\n    setTimeout(() => { document.getElementById('copy-status').textContent = ''; }, 3000);\n  }).catch(() => {\n    alert(\"Nội dung chia sẻ:\\n\\n\" + text);\n  });\n}\n\nfunction shuffle(arr) {\n  for (let i = arr.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [arr[i], arr[j]] = [arr[j], arr[i]];\n  }\n}\n\n// INITIALIZATION\nupdateOverviewUI();\n</script>\n</body>\n</html>\n","Description":"Tạo file ứng dụng trắc nghiệm 100 câu hỏi chính thức chuẩn Bộ Công an 2026, hỗ trợ học 3 ngày và chia sẻ qua mạng nội bộ / Zalo / trình duyệt.","Overwrite":true,"TargetFile":"C:\\Users\\Acer\\.gemini\\antigravity\\brain\\04883a7b-f14e-427c-a92d-cdc41dece94d\\quiz_dieulenh.html","toolAction":"Updating quiz application","toolSummary":"Update 100 official questions"}}]}
